CXX_STD = CXX20
PKG_CPPFLAGS = -I$(LP_PATH)/$(WIN)/lib/include -I$(MINGW_PATH)/mingw$(WIN)/include
PKG_LIBS = -Llibbaryonyx-0.5 -lbaryonyx-0.5

$(SHLIB): libbaryonyx-0.5/libbaryonyx-0.5.a

libbaryonyx-0.5/libbaryonyx-0.5.a:
        @(rm -fr libbaryonyx-0.5 && mkdir libbaryonyx-0.5)
        @(cp $(LP_PATH)/$(WIN)/lib/libbaryonyx-0.5.a libbaryonyx-0.5/libbaryonyx-0.5.a)

